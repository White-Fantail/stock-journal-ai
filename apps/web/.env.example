# Google sign-in. Example names ONLY; never commit values.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Exact deployed HTTPS origin, no path/query:
AUTH_URL=https://your-private-deployment.example
# Public HTTPS hostname of the HMAC-protected Railway identity service:
SAAS_INTERNAL_API_URL=https://your-saas-service.example
# Same private random 32+ character secret on web + Railway API:
SAAS_INTERNAL_SECRET=
# Railway service only (NEVER NEXT_PUBLIC_*):
# SAAS_DATABASE_URL=postgresql://...

# Optional financial features. Keep OFF until reviewed migration, restricted DB
# role and A/B hostile HTTP isolation + backup restore tests are complete.

# Tiger P3 partner flow is exclusively configured on Railway, not in Vercel.
# Tiger OAuth requires provider approval. See docs/saas/TIGER-P3-OAUTH.md.
