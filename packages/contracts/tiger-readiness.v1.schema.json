{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-journal-ai.invalid/contracts/tiger-readiness.v1.json",
  "title": "Authenticated owner-only Tiger connection status v1 (offline-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "source",
    "authorization",
    "brokerageQueries",
    "shadowSync",
    "outstanding"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "source": {
      "const": "NO_BROKER_CALLS"
    },
    "authorization": {
      "const": "NOT_CONNECTED"
    },
    "brokerageQueries": {
      "const": "DISABLED"
    },
    "shadowSync": {
      "const": "FIXTURES_ONLY"
    },
    "outstanding": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    }
  }
}
